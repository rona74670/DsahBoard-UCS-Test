# Copy this file to .env and fill in your values.
# Never commit .env to git.

# TC Farm
TC_HOST=10.x.x.x
TC_USER=
TC_PASS=

# PT Farm
PT_HOST=10.x.x.x
PT_USER=
PT_PASS=

# FATTAL Farm
FATTAL_HOST=10.x.x.x
FATTAL_USER=
FATTAL_PASS=

# Authentication
JWT_SECRET=
JWT_EXPIRE_HOURS=8
LOCAL_ONLY_USERS=rona

# Optional: TLS / encryption hardening
INFRA_CA_BUNDLE=
DB_ENCRYPT_KEY=

# Internal Ollama AI server (chatbot). Run scripts\setup_ollama_credentials.ps1
# to fill in OLLAMA_USER / OLLAMA_PASS_ENC (encrypted) if the server needs auth.
OLLAMA_HOST=10.114.36.10
OLLAMA_PORT=11434
OLLAMA_MODEL=
OLLAMA_USER=
OLLAMA_PASS_ENC=

# vCenter History — VM inventory snapshots
# How many regular (non-protected) snapshots to keep; older ones are pruned automatically.
VM_SNAPSHOT_RETENTION=100
# Password required to delete a *protected* snapshot (the automatic 1st-of-month 00:01 archive —
# see the "monthly-snapshot" background thread in app.py). Protected snapshots are never counted
# against VM_SNAPSHOT_RETENTION and are never auto-pruned.
SNAPSHOT_DELETE_PASSWORD=
